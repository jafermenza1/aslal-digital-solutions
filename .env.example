# Public
NEXT_PUBLIC_SITE_URL=https://aslaldigital.com
NEXT_PUBLIC_SITE_NAME=Aslal Digital Solutions

PRODUCTION_INTEGRITY_URL=https://aslaldigital.com/api/admin/production-integrity
PRODUCTION_INTEGRITY_TOKEN=<long-random-secret20226>

# MySQL (legacy/raw-SQL connection settings)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database
DB_CONNECTION_LIMIT=10

# Prisma MySQL connection string. Percent-encode special characters in the password.
DATABASE_URL=mysql://your_mysql_user:your_mysql_password@localhost:3306/your_mysql_database

# Admin authentication
ADMIN_EMAIL=admin@aslaldigital.com
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-secret
PRODUCTION_INTEGRITY_TOKEN=replace-with-a-long-random-monitoring-token

# Email / mailbox
# IMPORTANT: Quote password values when they contain special characters
# such as #, spaces, quotes, or other dotenv-significant characters.
SMTP_HOST=mail.aslaldigital.com
SMTP_PORT=587
SMTP_USER=support@aslaldigital.com
SMTP_PASSWORD="your_mailbox_password"
SMTP_FROM=support@aslaldigital.com
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

IMAP_HOST=mail.aslaldigital.com
IMAP_PORT=993
IMAP_USER=support@aslaldigital.com
IMAP_PASSWORD="your_mailbox_password"
IMAP_SECURE=true
IMAP_MAILBOX=INBOX

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional messaging
WHATSAPP_NUMBER=251911276682
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Production behavior
NODE_ENV=production
