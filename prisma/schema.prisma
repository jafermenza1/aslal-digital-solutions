generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum PartnerType {
  AGENT
  INFLUENCER
  AFFILIATE
  RESELLER
}

enum PartnerStatus {
  ACTIVE
  PAUSED
  PENDING
}

enum PartnerVerificationStatus {
  REGISTERED
  VERIFIED
  SUSPENDED
}

enum PartnerTier {
  STARTER
  VERIFIED
  PRO
  ELITE
}

enum CampaignStatus {
  DRAFT
  OPEN
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignPartnerStatus {
  INVITED
  APPLIED
  APPROVED
  ACTIVE
  DECLINED
  COMPLETED
  REMOVED
}

enum CampaignRewardType {
  FIXED
  PER_LEAD
  PERCENT_SALE
  HYBRID
  MARGIN
}

enum CampaignAssetType {
  CREATIVE
  COPY
  PRICE_SHEET
  QR
  POSTER
  LINK
}

enum CampaignAssetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PartnerDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum PartnerPayoutStatus {
  PENDING
  APPROVED
  PAID
  FAILED
  VOID
}

enum ProductRelationship {
  OWNED
  AFFILIATE
  RESELLER
  IMPLEMENTATION_PARTNER
  CUSTOM
}

enum CommissionStatus {
  PENDING
  QUALIFIED
  APPROVED
  PAYABLE
  PAID
  VOID
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadCaptureMode {
  WEB
  OFFLINE
  MANUAL
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  BUSINESS_OWNER
  SALES_MANAGER
  SALES_OPERATOR
  MARKETING_OPERATOR
  PARTNER_MANAGER
  PARTNER
}

enum WorkflowTriggerType {
  LEAD_CREATED
  LEAD_OVERDUE
  LEAD_STATUS_CHANGED
  CONVERSATION_INBOUND
  OPT_OUT
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum WorkflowActionType {
  CREATE_TASK
  CREATE_ACTIVITY
}

enum WorkflowActionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  SUPERSEDED
}

enum NegotiationEventType {
  CREATED
  SENT
  VIEWED
  REVISED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  SUPERSEDED
  NOTE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  CONFIRMED
  FAILED
  REVERSED
  REFUNDED
}

enum RevenueStatus {
  PENDING
  RECOGNIZED
  REVERSED
}

enum PaymentReconciliationStatus {
  UNMATCHED
  MATCHED
  RECONCILED
  EXCEPTION
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum CommunicationChannel {
  EMAIL
  SMS
  TELEGRAM
  WHATSAPP
  MESSENGER
}
enum ConversationStatus {
  OPEN
  HUMAN_HANDOFF
  CLOSED
}
enum MessageDirection {
  INBOUND
  OUTBOUND
}
enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model Visitor {
  id                  String   @id @db.Char(36)
  anonymousId         String   @unique @map("anonymous_id") @db.Char(36)
  firstSeenAt         DateTime @default(now()) @map("first_seen_at") @db.DateTime(0)
  lastSeenAt          DateTime @default(now()) @map("last_seen_at") @db.DateTime(0)
  firstSource         String?  @map("first_source") @db.VarChar(100)
  firstMedium         String?  @map("first_medium") @db.VarChar(100)
  firstCampaign       String?  @map("first_campaign") @db.VarChar(150)
  firstReferralCode   String?  @map("first_referral_code") @db.VarChar(100)
  leads               Lead[]
  events              Event[]
  referralClicks      ReferralClick[]
  growthOpportunities GrowthOpportunity[]

  @@index([lastSeenAt], map: "idx_visitors_last_seen")
  @@index([firstReferralCode], map: "idx_visitors_referral")
  @@map("visitors")
}

model Lead {
  workspaceId       String?            @map("workspace_id") @db.Char(36)
  id                String             @id @db.Char(36)
  visitorId         String?            @map("visitor_id") @db.Char(36)
  personId          String?            @map("person_id") @db.Char(36)
  name              String             @db.VarChar(160)
  email             String?            @db.VarChar(190)
  phone             String?            @db.VarChar(40)
  company           String?            @db.VarChar(190)
  businessType      String?            @map("business_type") @db.VarChar(100)
  message           String?            @db.Text
  status            LeadStatus         @default(NEW)
  score             Int                @default(0)
  source            String?            @db.VarChar(100)
  medium            String?            @db.VarChar(100)
  campaign          String?            @db.VarChar(150)
  ownerEmail        String?            @map("owner_email") @db.VarChar(190)
  nextAction        String?            @map("next_action") @db.VarChar(190)
  nextActionDueAt   DateTime?          @map("next_action_due_at") @db.DateTime(0)
  referralCode      String?            @map("referral_code") @db.VarChar(100)
  dealValue         Decimal?           @map("deal_value") @db.Decimal(15, 2)
  isTest            Boolean            @default(false) @map("is_test")
  captureMode       LeadCaptureMode    @default(WEB) @map("capture_mode")
  leadCategory      String?            @map("lead_category") @db.VarChar(100)
  wonAt             DateTime?          @map("won_at") @db.DateTime(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(0)
  visitor           Visitor?           @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  notes             LeadNote[]
  tasks             LeadTask[]
  stageHistory      LeadStageHistory[]
  productInterests  LeadProductInterest[]
  commissions       Commission[]
  person            Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunities     Opportunity[]
  conversations     Conversation[]
  partnerDisputes    PartnerDispute[]

  @@index([status], map: "idx_leads_status")
  @@index([score], map: "idx_leads_score")
  @@index([createdAt], map: "idx_leads_created")
  @@index([referralCode], map: "idx_leads_referral")
  @@index([personId], map: "idx_leads_person")
  @@index([ownerEmail, status], map: "idx_leads_owner_status")
  @@index([nextActionDueAt, status], map: "idx_leads_next_action_due_status")
  @@index([isTest, createdAt], map: "idx_leads_test_created")
  @@index([captureMode, createdAt], map: "idx_leads_capture_mode_created")
  @@index([leadCategory, createdAt], map: "idx_leads_category_created")
  @@map("leads")
  workspace         Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}

model Event {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  visitorId   String?   @map("visitor_id") @db.Char(36)
  eventName   String    @map("event_name") @db.VarChar(100)
  pagePath    String?   @map("page_path") @db.VarChar(500)
  productSlug String?   @map("product_slug") @db.VarChar(160)
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  visitor     Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([visitorId], map: "idx_events_visitor")
  @@index([eventName], map: "idx_events_name")
  @@index([productSlug], map: "idx_events_product")
  @@index([createdAt], map: "idx_events_created")
  @@map("events")
}

model Partner {
  workspaceId     String?         @map("workspace_id") @db.Char(36)
  id             String          @id @db.Char(36)
  partnerNumber  String          @unique @map("partner_number") @db.VarChar(30)
  name           String          @db.VarChar(160)
  email          String?         @db.VarChar(190)
  username       String?         @unique @db.VarChar(190)
  passwordHash   String?         @map("password_hash") @db.VarChar(255)
  portalRequested Boolean        @default(false) @map("portal_requested")
  type               PartnerType               @default(AGENT)
  status             PartnerStatus             @default(ACTIVE)
  verificationStatus PartnerVerificationStatus @default(REGISTERED) @map("verification_status")
  tier               PartnerTier               @default(STARTER)
  bio                String?                   @db.Text
  specialties        String?                   @db.Text
  serviceAreas       String?                   @map("service_areas") @db.Text
  audienceSize       Int?                      @map("audience_size")
  verificationNotes  String?                   @map("verification_notes") @db.Text
  verifiedAt         DateTime?                 @map("verified_at") @db.DateTime(0)
  verifiedBy         String?                   @map("verified_by") @db.VarChar(190)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  referralLinks      ReferralLink[]
  commissions        Commission[]
  revenues           Revenue[]
  orders             Order[]
  user               User?
  campaignPartners   CampaignPartner[]
  disputes           PartnerDispute[]
  competingDisputes  PartnerDispute[] @relation("PartnerDisputeCompetingPartner")
  awardedDisputes    PartnerDispute[] @relation("PartnerDisputeAwardedPartner")
  payouts            PartnerPayout[]
  workspace          Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([verificationStatus], map: "idx_partners_verification")
  @@index([tier], map: "idx_partners_tier")

  @@index([status], map: "idx_partners_status")
  @@map("partners")
}

model ReferralLink {
  workspaceId     String?          @map("workspace_id") @db.Char(36)
  id              String          @id @db.Char(36)
  partnerId       String          @map("partner_id") @db.Char(36)
  code            String           @unique @db.VarChar(100)
  campaign        String?          @db.VarChar(150)
  productSlug     String?          @map("product_slug") @db.VarChar(160)
  destinationPath String          @default("/") @map("destination_path") @db.VarChar(500)
  campaignId      String?         @map("campaign_id") @db.Char(36)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerCampaign PartnerCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clicks          ReferralClick[]
  commissions     Commission[]
  orders          Order[]
  revenues        Revenue[]
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([partnerId], map: "idx_referral_partner")
  @@index([campaignId], map: "idx_referral_campaign")
  @@map("referral_links")
}

model ReferralClick {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  referralLinkId String       @map("referral_link_id") @db.Char(36)
  visitorId      String?      @map("visitor_id") @db.Char(36)
  ipHash         String?      @map("ip_hash") @db.Char(64)
  userAgent      String?      @map("user_agent") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  referralLink   ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  visitor        Visitor?     @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([referralLinkId], map: "idx_click_link")
  @@index([visitorId], map: "idx_click_visitor")
  @@map("referral_clicks")
}

model Product {
  id               String              @id @db.Char(36)
  slug             String              @unique @db.VarChar(160)
  name             String              @db.VarChar(190)
  kind             ProductKind         @default(PRODUCT)
  providerName     String?             @map("provider_name") @db.VarChar(190)
  relationshipType ProductRelationship @default(OWNED) @map("relationship_type")
  tagline          String?             @db.VarChar(250)
  shortDescription String              @map("short_description") @db.VarChar(500)
  description      String?             @db.Text
  features         String?             @db.Text
  benefits         String?             @db.Text
  idealFor         String?             @map("ideal_for") @db.Text
  deliverables     String?             @db.Text
  imageUrl         String?             @map("image_url") @db.VarChar(1000)
  galleryUrls      String?             @map("gallery_urls") @db.Text
  startingPrice    String?             @map("starting_price") @db.VarChar(100)
  ctaLabel         String?             @map("cta_label") @db.VarChar(80)
  ctaNote          String?             @map("cta_note") @db.VarChar(250)
  sortOrder        Int                 @default(0) @map("sort_order")
  featured         Boolean             @default(false)
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(0)
  interests        LeadProductInterest[]
  campaigns        PartnerCampaign[]

  @@index([kind, active, sortOrder], map: "idx_products_kind_active_sort")
  @@index([featured], map: "idx_products_featured")
  @@index([active], map: "idx_products_active")
  @@map("products")
}

model Revenue {
  workspaceId        String?       @map("workspace_id") @db.Char(36)
  id                String        @id @db.Char(36)
  orderId           String        @map("order_id") @db.Char(36)
  paymentId         String        @unique @map("payment_id") @db.Char(36)
  customerId        String?       @map("customer_id") @db.Char(36)
  partnerId         String?       @map("partner_id") @db.Char(36)
  referralLinkId    String?       @map("referral_link_id") @db.Char(36)
  collectedAmount   Decimal       @default(0) @map("collected_amount") @db.Decimal(15,2)
  recognizedAmount  Decimal       @default(0) @map("recognized_amount") @db.Decimal(15,2)
  commissionableAmount Decimal    @default(0) @map("commissionable_amount") @db.Decimal(15,2)
  currency          String        @default("ETB") @db.VarChar(10)
  status            RevenueStatus @default(PENDING)
  basis             String        @default("CONFIRMED_RECONCILED_PAYMENT") @db.VarChar(80)
  recognizedAt      DateTime?     @map("recognized_at") @db.DateTime(0)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.DateTime(0)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  partner           Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  referralLink      ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  commission        Commission?
  workspace          Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt], map: "idx_revenue_order_created")
  @@index([partnerId, createdAt], map: "idx_revenue_partner_created")
  @@index([status, recognizedAt], map: "idx_revenue_status_recognized")
  @@map("revenues")
}

model Commission {
  workspaceId    String?          @map("workspace_id") @db.Char(36)
  id             String           @id @db.Char(36)
  partnerId      String           @map("partner_id") @db.Char(36)
  leadId         String?          @map("lead_id") @db.Char(36)
  referralLinkId String?          @map("referral_link_id") @db.Char(36)
  orderId        String?          @map("order_id") @db.Char(36)
  paymentId      String?          @unique @map("payment_id") @db.Char(36)
  revenueId      String?          @unique @map("revenue_id") @db.Char(36)
  amount         Decimal          @default(0) @db.Decimal(15, 2)
  currency       String           @default("ETB") @db.VarChar(10)
  status         CommissionStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  partner        Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  referralLink   ReferralLink?    @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment        Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  revenue        Revenue?         @relation(fields: [revenueId], references: [id], onDelete: SetNull)
  payoutItems    PartnerPayoutItem[]
  disputes       PartnerDispute[]
  workspace      Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([partnerId], map: "idx_commission_partner")
  @@index([status], map: "idx_commission_status")
  @@index([orderId], map: "idx_commission_order")
  @@index([paymentId], map: "idx_commission_payment")
  @@map("commissions")
}

model LeadNote {
  id        String   @id @db.Char(36)
  leadId    String   @map("lead_id") @db.Char(36)
  body      String   @db.Text
  author    String?  @db.VarChar(190)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt], map: "idx_lead_notes_lead_created")
  @@map("lead_notes")
}

model LeadTask {
  id          String       @id @db.Char(36)
  leadId      String       @map("lead_id") @db.Char(36)
  title       String       @db.VarChar(190)
  description String?      @db.Text
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(NORMAL)
  dueAt       DateTime?    @map("due_at") @db.DateTime(0)
  completedAt DateTime?    @map("completed_at") @db.DateTime(0)
  assignedTo  String?      @map("assigned_to") @db.VarChar(190)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status], map: "idx_lead_tasks_lead_status")
  @@index([dueAt, status], map: "idx_lead_tasks_due_status")
  @@map("lead_tasks")
}


model Workflow {
  id          String              @id @db.Char(36)
  systemKey   String              @unique @map("system_key") @db.VarChar(100)
  name        String              @db.VarChar(190)
  description String?             @db.Text
  ownerEmail  String?             @map("owner_email") @db.VarChar(190)
  triggerType WorkflowTriggerType @map("trigger_type")
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.DateTime(0)
  versions    WorkflowVersion[]
  executions  WorkflowExecution[]

  @@index([triggerType, active], map: "idx_workflows_trigger_active")
  @@map("workflows")
}

model WorkflowVersion {
  id          String    @id @db.Char(36)
  workflowId  String    @map("workflow_id") @db.Char(36)
  versionNo   Int       @map("version_no")
  definition  Json
  createdBy   String?   @map("created_by") @db.VarChar(190)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]

  @@unique([workflowId, versionNo], map: "uq_workflow_version")
  @@index([workflowId, createdAt], map: "idx_workflow_versions_workflow_created")
  @@map("workflow_versions")
}

model WorkflowExecution {
  id               String                  @id @db.Char(36)
  workflowId       String                  @map("workflow_id") @db.Char(36)
  workflowVersionId String                 @map("workflow_version_id") @db.Char(36)
  triggerType      WorkflowTriggerType    @map("trigger_type")
  idempotencyKey   String                  @unique @map("idempotency_key") @db.VarChar(255)
  targetType       String                 @map("target_type") @db.VarChar(40)
  targetId         String                 @map("target_id") @db.Char(36)
  status           WorkflowExecutionStatus @default(PENDING)
  payload          Json?
  result           Json?
  attempts         Int                    @default(0)
  lastError       String?                 @map("last_error") @db.Text
  startedAt       DateTime?               @map("started_at") @db.DateTime(0)
  completedAt     DateTime?               @map("completed_at") @db.DateTime(0)
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(0)
  workflow         Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion  WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  actions          WorkflowActionExecution[]

  @@index([status, createdAt], map: "idx_workflow_executions_status_created")
  @@index([targetType, targetId, createdAt], map: "idx_workflow_executions_target_created")
  @@index([workflowId, createdAt], map: "idx_workflow_executions_workflow_created")
  @@map("workflow_executions")
}

model WorkflowActionExecution {
  id           String                @id @db.Char(36)
  executionId  String                @map("execution_id") @db.Char(36)
  actionIndex  Int                   @map("action_index")
  actionType   WorkflowActionType    @map("action_type")
  status       WorkflowActionStatus  @default(PENDING)
  scheduledFor DateTime?             @map("scheduled_for") @db.DateTime(0)
  startedAt    DateTime?             @map("started_at") @db.DateTime(0)
  completedAt  DateTime?             @map("completed_at") @db.DateTime(0)
  attempts     Int                   @default(0)
  error       String?                @db.Text
  result      Json?
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.DateTime(0)
  execution    WorkflowExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, actionIndex], map: "uq_workflow_action_execution")
  @@index([executionId, status], map: "idx_workflow_action_execution_status")
  @@index([scheduledFor, status], map: "idx_workflow_action_execution_scheduled")
  @@map("workflow_action_executions")
}

model LeadStageHistory {
  id        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  leadId    String     @map("lead_id") @db.Char(36)
  fromStage LeadStatus? @map("from_stage")
  toStage   LeadStatus @map("to_stage")
  note      String?    @db.VarChar(500)
  changedBy String?    @map("changed_by") @db.VarChar(190)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt], map: "idx_lead_stage_history_lead_created")
  @@map("lead_stage_history")
}

model LeadProductInterest {
  id            String   @id @db.Char(36)
  leadId        String   @map("lead_id") @db.Char(36)
  productId     String   @map("product_id") @db.Char(36)
  source        String?  @db.VarChar(100)
  interestScore Int      @default(1) @map("interest_score")
