  order           Order?

  @@index([customerId, createdAt], map: "idx_quotes_customer_created")
  @@index([opportunityId, createdAt], map: "idx_quotes_opportunity_created")
  @@index([parentQuoteId], map: "idx_quotes_parent")
  @@index([status, expiresAt], map: "idx_quotes_status_expires")
