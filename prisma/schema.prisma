  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  parentQuote     Quote?     @relation("QuoteRevision", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions       Quote[]    @relation("QuoteRevision")
