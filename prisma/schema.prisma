  permissions     Json?
  active          Boolean  @default(true)
  lastLoginAt     DateTime? @map("last_login_at") @db.DateTime(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  partnerId       String?  @unique @map("partner_id") @db.Char(36)
  partner         Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  workspaceUsers   WorkspaceUser[]
  audits          UserAudit[]

  @@index([active, role], map: "idx_users_active_role")
  @@map("users")
}

model UserAudit {
  id        String   @id @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  actor     String   @db.VarChar(190)
  action    String   @db.VarChar(50)
  reason    String   @db.Text
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_user_audit_user_created")
  @@index([action, createdAt], map: "idx_user_audit_action_created")
  @@map("user_audits")
}

model EmailTemplate {
  id               String   @id @db.Char(36)
  templateKey      String   @unique @map("template_key") @db.VarChar(120)
  name             String   @db.VarChar(190)
  subjectTemplate  String   @map("subject_template") @db.VarChar(250)
  htmlTemplate     String   @map("html_template") @db.Text
  textTemplate     String   @map("text_template") @db.Text
  transactional    Boolean  @default(true)
  active           Boolean  @default(true)
  updatedBy        String?  @map("updated_by") @db.VarChar(190)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([active, transactional], map: "idx_email_templates_active_transactional")
  @@map("email_templates")
}

model LeadAdminAudit {
  id        String   @id @db.Char(36)
  leadId    String?  @map("lead_id") @db.Char(36)
  actor     String   @db.VarChar(190)
  action    String   @db.VarChar(40)
  reason    String   @db.Text
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  @@index([leadId, createdAt], map: "idx_lead_admin_audit_lead_created")
  @@index([action, createdAt], map: "idx_lead_admin_audit_action_created")
  @@map("lead_admin_audits")
}

model PartnerCampaign {
  workspaceId          String?              @map("workspace_id") @db.Char(36)
  id                  String               @id @db.Char(36)
  name                String               @db.VarChar(190)
  description         String?              @db.Text
  status              CampaignStatus       @default(DRAFT)
  targetDescription   String?              @map("target_description") @db.Text
  location            String?              @db.VarChar(190)
  budget              Decimal              @default(0) @db.Decimal(15,2)
  partnerBudget       Decimal              @default(0) @map("partner_budget") @db.Decimal(15,2)
  currency            String               @default("ETB") @db.VarChar(10)
  rewardType          CampaignRewardType   @default(FIXED) @map("reward_type")
  rewardAmount        Decimal?             @map("reward_amount") @db.Decimal(15,2)
  rewardRate          Decimal?             @map("reward_rate") @db.Decimal(7,4)
  requiredPartnerTypes String?            @map("required_partner_types") @db.Text
  productId           String?              @map("product_id") @db.Char(36)
  startsAt            DateTime?            @map("starts_at") @db.DateTime(0)
  endsAt              DateTime?            @map("ends_at") @db.DateTime(0)
  createdBy           String?              @map("created_by") @db.VarChar(190)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.DateTime(0)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  partners            CampaignPartner[]
  referralLinks       ReferralLink[]
  assets              CampaignAsset[]
  disputes            PartnerDispute[]

  @@index([status, startsAt, endsAt], map: "idx_partner_campaign_status_dates")
  @@index([location], map: "idx_partner_campaign_location")
  @@index([productId], map: "idx_partner_campaign_product")
  @@map("partner_campaigns")
  workspace             Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}

model CampaignAsset {
  workspaceId String?             @map("workspace_id") @db.Char(36)
  id          String              @id @db.Char(36)
  campaignId  String              @map("campaign_id") @db.Char(36)
  name        String              @db.VarChar(190)
  type        CampaignAssetType
  status      CampaignAssetStatus @default(DRAFT)
  description String?             @db.Text
  content     String?             @db.Text
  assetUrl    String?             @map("asset_url") @db.VarChar(1000)
  placement   String?             @db.VarChar(190)
  trackingCode String?            @map("tracking_code") @db.VarChar(190)
  createdBy   String?             @map("created_by") @db.VarChar(190)
  createdAt   DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.DateTime(0)
  campaign    PartnerCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([campaignId, status, type], map: "idx_campaign_assets_campaign_status_type")
  @@index([trackingCode], map: "idx_campaign_assets_tracking_code")
  @@map("campaign_assets")
}

model CampaignPartner {
  id           String                @id @db.Char(36)
  campaignId   String                @map("campaign_id") @db.Char(36)
  partnerId    String                @map("partner_id") @db.Char(36)
  status       CampaignPartnerStatus @default(APPLIED)
  role         PartnerType?
  appliedAt    DateTime              @default(now()) @map("applied_at") @db.DateTime(0)
  approvedAt   DateTime?             @map("approved_at") @db.DateTime(0)
  completedAt  DateTime?             @map("completed_at") @db.DateTime(0)
  notes        String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.DateTime(0)
  campaign     PartnerCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  partner      Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, partnerId], map: "uq_campaign_partner")
  @@index([partnerId, status], map: "idx_campaign_partner_partner_status")
  @@index([campaignId, status], map: "idx_campaign_partner_campaign_status")
  @@map("campaign_partners")
}

model PartnerDispute {
  workspaceId          String?              @map("workspace_id") @db.Char(36)
  id                  String               @id @db.Char(36)
  partnerId           String               @map("partner_id") @db.Char(36)
  competingPartnerId  String?              @map("competing_partner_id") @db.Char(36)
  awardedPartnerId    String?              @map("awarded_partner_id") @db.Char(36)
  leadId              String?              @map("lead_id") @db.Char(36)
  campaignId          String?              @map("campaign_id") @db.Char(36)
  commissionId        String?              @map("commission_id") @db.Char(36)
  subject             String               @db.VarChar(190)
  description         String               @db.Text
  evidenceRef         String?              @map("evidence_ref") @db.VarChar(1000)
  decisionNotes       String?              @map("decision_notes") @db.Text
  status              PartnerDisputeStatus @default(OPEN)
  resolution          String?              @db.Text
  resolvedBy          String?              @map("resolved_by") @db.VarChar(190)
  resolvedAt          DateTime?            @map("resolved_at") @db.DateTime(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.DateTime(0)
  partner             Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  competingPartner    Partner?             @relation("PartnerDisputeCompetingPartner", fields: [competingPartnerId], references: [id], onDelete: SetNull)
  awardedPartner      Partner?             @relation("PartnerDisputeAwardedPartner", fields: [awardedPartnerId], references: [id], onDelete: SetNull)
  lead                Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign            PartnerCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  commission          Commission?          @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([partnerId, status, createdAt], map: "idx_partner_disputes_partner_status")
  @@index([competingPartnerId, status], map: "idx_partner_disputes_competing_status")
  @@index([awardedPartnerId, status], map: "idx_partner_disputes_awarded_status")
  @@index([leadId, status], map: "idx_partner_disputes_lead_status")
  @@index([status, createdAt], map: "idx_partner_disputes_status_created")
  @@map("partner_disputes")
}

model PartnerPayout {
  workspaceId String?             @map("workspace_id") @db.Char(36)
  id          String              @id @db.Char(36)
  partnerId   String              @map("partner_id") @db.Char(36)
  amount      Decimal             @default(0) @db.Decimal(15,2)
  currency    String              @default("ETB") @db.VarChar(10)
  status      PartnerPayoutStatus @default(PENDING)
  reference   String?              @db.VarChar(190)
  notes       String?              @db.Text
  paidAt      DateTime?            @map("paid_at") @db.DateTime(0)
  createdAt   DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.DateTime(0)
  partner     Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  items       PartnerPayoutItem[]
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([partnerId, status, createdAt], map: "idx_partner_payouts_partner_status")
  @@index([status, createdAt], map: "idx_partner_payouts_status_created")
  @@map("partner_payouts")
}

model PartnerPayoutItem {
  id           String        @id @db.Char(36)
  payoutId     String        @map("payout_id") @db.Char(36)
  commissionId String        @map("commission_id") @db.Char(36)
  amount       Decimal       @default(0) @db.Decimal(15,2)
  payout       PartnerPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commission   Commission    @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@unique([payoutId, commissionId], map: "uq_payout_commission")
  @@index([commissionId], map: "idx_payout_item_commission")
  @@map("partner_payout_items")
}
