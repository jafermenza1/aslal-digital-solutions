model Visitor {
  id                  String   @id @db.Char(36)
  anonymousId         String   @unique @map("anonymous_id") @db.Char(36)
  firstSeenAt         DateTime @default(now()) @map("first_seen_at") @db.DateTime(0)
  lastSeenAt          DateTime @default(now()) @map("last_seen_at") @db.DateTime(0)
  firstSource         String?  @map("first_source") @db.VarChar(100)
  firstMedium         String?  @map("first_medium") @db.VarChar(100)
  firstCampaign       String?  @map("first_campaign") @db.VarChar(150)
  firstReferralCode   String?  @map("first_referral_code") @db.VarChar(100)
  leads               Lead[]
  events              Event[]
  referralClicks      ReferralClick[]
  growthOpportunities GrowthOpportunity[]

  @@index([lastSeenAt], map: "idx_visitors_last_seen")
  @@index([firstReferralCode], map: "idx_visitors_referral")
  @@map("visitors")
}

model Lead {
  workspaceId       String?            @map("workspace_id") @db.Char(36)
  id                String             @id @db.Char(36)
  visitorId         String?            @map("visitor_id") @db.Char(36)
  personId          String?            @map("person_id") @db.Char(36)
  name              String             @db.VarChar(160)
  email             String?            @db.VarChar(190)
  phone             String?            @db.VarChar(40)
  telegramUsername  String?            @map("telegram_username") @db.VarChar(190)
  telegramChatId    String?            @map("telegram_chat_id") @db.VarChar(80)
  company           String?            @db.VarChar(190)
  businessType      String?            @map("business_type") @db.VarChar(100)
  message           String?            @db.Text
  status            LeadStatus         @default(NEW)
  score             Int                @default(0)
  source            String?            @db.VarChar(100)
  medium            String?            @db.VarChar(100)
  campaign          String?            @db.VarChar(150)
  ownerEmail        String?            @map("owner_email") @db.VarChar(190)
  nextAction        String?            @map("next_action") @db.VarChar(190)
  nextActionDueAt   DateTime?          @map("next_action_due_at") @db.DateTime(0)
  referralCode      String?            @map("referral_code") @db.VarChar(100)
  attributionLockedAt DateTime?         @map("attribution_locked_at") @db.DateTime(0)
  attributionLockedBy String?            @map("attribution_locked_by") @db.VarChar(190)
  attributionOverrideReason String?     @map("attribution_override_reason") @db.Text
  attributionExpiresAt DateTime?          @map("attribution_expires_at") @db.DateTime(0)
  dealValue         Decimal?           @map("deal_value") @db.Decimal(15, 2)
  isTest            Boolean            @default(false) @map("is_test")
  captureMode       LeadCaptureMode    @default(WEB) @map("capture_mode")
  leadCategory      String?            @map("lead_category") @db.VarChar(100)
  wonAt             DateTime?          @map("won_at") @db.DateTime(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(0)
  visitor           Visitor?           @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  notes             LeadNote[]
  tasks             LeadTask[]
  stageHistory      LeadStageHistory[]
  productInterests  LeadProductInterest[]
  attributions      LeadAttribution[]
  commissions       Commission[]
  person            Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunities     Opportunity[]
  conversations     Conversation[]
  partnerDisputes    PartnerDispute[]
  commercialDealRegistrations CommercialDealRegistration[]

  @@index([status], map: "idx_leads_status")
  @@index([score], map: "idx_leads_score")
  @@index([createdAt], map: "idx_leads_created")
  @@index([referralCode], map: "idx_leads_referral")
  @@index([personId], map: "idx_leads_person")
  @@index([ownerEmail, status], map: "idx_leads_owner_status")
  @@index([telegramUsername], map: "idx_leads_telegram_username")
  @@index([nextActionDueAt, status], map: "idx_leads_next_action_due_status")
  @@index([isTest, createdAt], map: "idx_leads_test_created")
  @@index([captureMode, createdAt], map: "idx_leads_capture_mode_created")
  @@index([leadCategory, createdAt], map: "idx_leads_category_created")
  @@map("leads")
  workspace         Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}

model LeadAttribution {
  id String @id @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  leadId String @map("lead_id") @db.Char(36)
  attributionType String @map("attribution_type") @db.VarChar(40)
  source String? @db.VarChar(100)
  medium String? @db.VarChar(100)
  campaign String? @db.VarChar(150)
  content String? @db.VarChar(190)
  term String? @db.VarChar(190)
  referralCode String? @map("referral_code") @db.VarChar(100)
  referralLinkId String? @map("referral_link_id") @db.Char(36)
  partnerId String? @map("partner_id") @db.Char(36)
  campaignId String? @map("campaign_id") @db.Char(36)
  productId String? @map("product_id") @db.Char(36)
  resourceId String? @map("resource_id") @db.Char(36)
  isFirstTouch Boolean @default(true) @map("is_first_touch")
  isLastTouch Boolean @default(true) @map("is_last_touch")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Restrict)
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade)
  referralLink ReferralLink? @relation(fields:[referralLinkId], references:[id], onDelete:SetNull)
  partner Partner? @relation(fields:[partnerId], references:[id], onDelete:SetNull)
  campaignRef PartnerCampaign? @relation(fields:[campaignId], references:[id], onDelete:SetNull)
  product Product? @relation(fields:[productId], references:[id], onDelete:SetNull)
  resource Resource? @relation(fields:[resourceId], references:[id], onDelete:SetNull)
  @@index([leadId,createdAt], map:"idx_lead_attr_lead")
  @@index([workspaceId,createdAt], map:"idx_lead_attr_workspace")
  @@index([partnerId], map:"idx_lead_attr_partner")
  @@index([campaignId], map:"idx_lead_attr_campaign")
  @@index([source,medium,campaign], map:"idx_lead_attr_source")
  @@map("lead_attributions")
}

model SocialProfile {
  id String @id @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  platform String @db.VarChar(40)
  label String @db.VarChar(80)
  url String @db.VarChar(1000)
  handle String? @db.VarChar(190)
  displayOrder Int @default(0) @map("display_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId,platform], map:"uq_social_profile_workspace_platform")
  @@index([workspaceId,isActive,displayOrder], map:"idx_social_profile_workspace_active")
  @@map("social_profiles")
}

model ResourceAttribution {
  id String @id @db.Char(36)
  resourceRequestId String @map("resource_request_id") @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  referralCode String? @map("referral_code") @db.VarChar(100)
  referralLinkId String? @map("referral_link_id") @db.Char(36)
  partnerId String? @map("partner_id") @db.Char(36)
  campaignId String? @map("campaign_id") @db.Char(36)
  source String? @db.VarChar(100)
  medium String? @db.VarChar(100)
  campaign String? @db.VarChar(150)
  content String? @db.VarChar(190)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  request ResourceRequest @relation(fields:[resourceRequestId], references:[id], onDelete:Cascade)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Restrict)
  referralLink ReferralLink? @relation(fields:[referralLinkId], references:[id], onDelete:SetNull)
  partner Partner? @relation(fields:[partnerId], references:[id], onDelete:SetNull)
  campaignRef PartnerCampaign? @relation(fields:[campaignId], references:[id], onDelete:SetNull)
  @@index([resourceRequestId], map:"idx_resource_attr_request")
  @@index([partnerId], map:"idx_resource_attr_partner")
  @@index([campaignId], map:"idx_resource_attr_campaign")
  @@map("resource_attributions")
}

model Event {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  visitorId   String?   @map("visitor_id") @db.Char(36)
  eventName   String    @map("event_name") @db.VarChar(100)
  pagePath    String?   @map("page_path") @db.VarChar(500)
  productSlug String?   @map("product_slug") @db.VarChar(160)
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  visitor     Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([visitorId], map: "idx_events_visitor")
  @@index([eventName], map: "idx_events_name")
  @@index([productSlug], map: "idx_events_product")
  @@index([createdAt], map: "idx_events_created")
  @@map("events")
}

model PartnerIdentity {
  id        String   @id @db.Char(36)
  name      String   @db.VarChar(160)
  email     String?  @db.VarChar(190)
  phone     String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  partners  Partner[]
  @@index([email], map:"idx_partner_identity_email")
  @@index([phone], map:"idx_partner_identity_phone")
  @@map("partner_identities")
}

model Partner {
  identityId String? @map("identity_id") @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  id             String          @id @db.Char(36)
  partnerNumber  String          @unique @map("partner_number") @db.VarChar(30)
  name           String          @db.VarChar(160)
  email          String?         @db.VarChar(190)
  username       String?         @unique @db.VarChar(190)
  passwordHash   String?         @map("password_hash") @db.VarChar(255)
  portalRequested Boolean        @default(false) @map("portal_requested")
  accountStatus PartnerAccountStatus @default(REGISTERED) @map("account_status")
  verificationLevel PartnerVerificationLevel @default(BASIC) @map("verification_level")
  onboardingStatus PartnerOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingStep PartnerOnboardingStep @default(PROFILE) @map("onboarding_step")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(0)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.DateTime(0)
  country String? @db.VarChar(100)
  phone String? @db.VarChar(40)
  restrictedReason String? @map("restricted_reason") @db.Text
  telegramChatId String?         @unique @map("telegram_chat_id") @db.VarChar(80)
  telegramLinkToken String?      @unique @map("telegram_link_token") @db.VarChar(100)
  telegramLinkedAt DateTime?     @map("telegram_linked_at") @db.DateTime(0)
  type               PartnerType               @default(AGENT)
  status             PartnerStatus             @default(ACTIVE)
  verificationStatus PartnerVerificationStatus @default(REGISTERED) @map("verification_status")
  tier               PartnerTier               @default(STARTER)
  bio                String?                   @db.Text
  specialties        String?                   @db.Text
  serviceAreas       String?                   @map("service_areas") @db.Text
  audienceSize       Int?                      @map("audience_size")
  verificationNotes  String?                   @map("verification_notes") @db.Text
  verifiedAt         DateTime?                 @map("verified_at") @db.DateTime(0)
  verifiedBy         String?                   @map("verified_by") @db.VarChar(190)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  referralLinks      ReferralLink[]
  attributions       LeadAttribution[]
  resourceAttributions ResourceAttribution[]
  commissions        Commission[]
  revenues           Revenue[]
  orders             Order[]
  user               User?
  identity           PartnerIdentity? @relation(fields:[identityId], references:[id], onDelete:SetNull)
  campaignPartners   CampaignPartner[]
  commissionContracts CommissionContract[]
  disputes           PartnerDispute[]
  competingDisputes  PartnerDispute[] @relation("PartnerDisputeCompetingPartner")
  awardedDisputes    PartnerDispute[] @relation("PartnerDisputeAwardedPartner")
  payouts            PartnerPayout[]
  verificationChallenges PartnerVerificationChallenge[]
  payoutProfile PartnerPayoutProfile?
  termsAcceptances PartnerTermsAcceptance[]
  commercialListingAuthorizations CommercialListingAuthorization[]
  commercialEligibilityDecisions CommercialEligibilityDecisionRecord[]
  commercialDealRegistrations CommercialDealRegistration[]
  commercialAppointments CommercialAppointment[]
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([verificationStatus], map: "idx_partners_verification")
  @@index([tier], map: "idx_partners_tier")

  @@index([status], map: "idx_partners_status")
  @@index([accountStatus], map: "idx_partners_account_status")
  @@index([verificationLevel], map: "idx_partners_verification_level")
  @@index([identityId], map:"idx_partners_identity")
  @@map("partners")
}

model PartnerVerificationChallenge {
  id String @id @db.Char(36)
  partnerId String @map("partner_id") @db.Char(36)
  channel PartnerVerificationChannel
  destination String @db.VarChar(190)
  tokenHash String @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  consumedAt DateTime? @map("consumed_at") @db.DateTime(0)
  attemptCount Int @default(0) @map("attempt_count")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  partner Partner @relation(fields:[partnerId], references:[id], onDelete:Cascade)
  @@index([partnerId,channel,consumedAt], map:"idx_partner_verification_challenge")
  @@index([tokenHash], map:"idx_partner_verification_token")
  @@map("partner_verification_challenges")
}

model PartnerPayoutProfile {
  id String @id @db.Char(36)
  partnerId String @unique @map("partner_id") @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  method String @default("BANK") @db.VarChar(40)
  accountName String? @map("account_name") @db.VarChar(190)
  accountNumber String? @map("account_number") @db.VarChar(190)
  bankName String? @map("bank_name") @db.VarChar(190)
  mobileWallet String? @map("mobile_wallet") @db.VarChar(190)
  country String? @db.VarChar(100)
  currency String @default("ETB") @db.VarChar(10)
  verified Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  partner Partner @relation(fields:[partnerId], references:[id], onDelete:Cascade)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Restrict)
  @@index([workspaceId,verified], map:"idx_partner_payout_profile_workspace")
  @@map("partner_payout_profiles")
}

model PartnerTermsAcceptance {
  id String @id @db.Char(36)
  partnerId String @map("partner_id") @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  programId String @map("program_id") @db.Char(36)
  termsId String @map("terms_id") @db.Char(36)
  contractId String? @map("contract_id") @db.Char(36)
