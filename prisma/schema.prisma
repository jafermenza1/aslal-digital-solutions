  @@map("conversation_messages")
}

model TelegramDestination {
  id                    String   @id @db.Char(36)
  workspaceId            String   @map("workspace_id") @db.Char(36)
  chatId                 String   @unique @map("chat_id") @db.VarChar(190)
  type                   TelegramDestinationType
  label                  String   @db.VarChar(190)
  active                 Boolean  @default(true)
  optIn                  Boolean  @default(false) @map("opt_in")
  linkToken              String?  @unique @map("link_token") @db.VarChar(100)
  leadId                String?  @map("lead_id") @db.Char(36)
  salesOwnerEmail       String?  @map("sales_owner_email") @db.VarChar(190)
  personId              String?  @map("person_id") @db.Char(36)
  productId             String?  @map("product_id") @db.Char(36)
  campaignId            String?  @map("campaign_id") @db.Char(36)
  partnerId             String?  @map("partner_id") @db.Char(36)
  referralCode          String?  @map("referral_code") @db.VarChar(100)
  source                String?  @db.VarChar(100)
  medium                String?  @db.VarChar(100)
  followUpEnabled       Boolean  @default(false) @map("follow_up_enabled")
  followUpMessage       String?  @map("follow_up_message") @db.Text
  followUpIntervalMinutes Int    @default(1440) @map("follow_up_interval_minutes")
  followUpMaxAttempts   Int      @default(3) @map("follow_up_max_attempts")
  followUpAttempts      Int      @default(0) @map("follow_up_attempts")
  nextFollowUpAt        DateTime? @map("next_follow_up_at") @db.DateTime(0)
  lastInboundAt         DateTime? @map("last_inbound_at") @db.DateTime(0)
  handedOffAt           DateTime? @map("handed_off_at") @db.DateTime(0)
  createdBy             String?  @map("created_by") @db.VarChar(190)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, active, type], map: "idx_telegram_dest_workspace_active")
  @@index([workspaceId, followUpEnabled, nextFollowUpAt], map: "idx_telegram_followup_due")
  @@index([leadId], map: "idx_telegram_dest_lead")