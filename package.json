  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-og-image.mjs",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:check": "node scripts/db-check.mjs",
    "db:seed": "node scripts/seed.mjs",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "q1:test-boundary": "node script/q1-workspace-boundary-negative-tests.mjs",
    "hardening:test": "node scripts/production-hardening-tests.mjs",
    "hardening:security": "npm audit --omit=dev --audit-level=high",
    "brand:check": "node scripts/brand-color-check.mjs",
    "seo:check": "node scripts/seo-georoute-check.mjs",
    "pcce-1:check": "node scripts/pcce-1-contract-check.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "@prisma/client": "6.19.3",
    "imapflow": "2.2.1",
    "mailparser": "3.9.33",
    "mysql2": "3.24.3",
    "next": "16.3.8",
    "nodemailer": "10.0.14",
    "react": "19.3.0",
    "react-dom": "19.2.8",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "framer-motion": "13.4.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6"
  },
  "engines": {
    "node": ">=20.9.0"
  },
