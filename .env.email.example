# Production Email channel
# If SMTP_HOST/IMAP_HOST are omitted, MAIL_SERVER_HOST is used for both.
# For the current Emerald/DirectAdmin server, this may be the server hostname
# shown by webmail: emerald.da.hostns.io. Use the provider's documented
# mail-client hostname if it differs.
MAIL_SERVER_HOST=emerald.da.hostns.io

SMTP_HOST=mail.aslaldigital.com
SMTP_PORT=587
SMTP_USER=support@aslaldigital.com
SMTP_PASSWORD=
SMTP_FROM=support@aslaldigital.com
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Incoming mailbox
IMAP_HOST=mail.aslaldigital.com
IMAP_PORT=993
IMAP_USER=support@aslaldigital.com
IMAP_PASSWORD=
IMAP_SECURE=true
IMAP_MAILBOX=INBOX

# Random long secret used only by the scheduled inbox poller
EMAIL_INBOX_CRON_SECRET=
